<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Bindery.Host</RootNamespace>
    <AssemblyName>Bindery.Host</AssemblyName>
    <UserSecretsId>bindery-host</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.11" />
    <!-- The sanitizer between untrusted plugin markup and an authenticated session.
         Maintained and AngleSharp-backed; see docs/PLUGIN-UI.md on why it is never hand-rolled. -->
    <PackageReference Include="HtmlSanitizer" Version="9.2.995" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Bindery.Core/Bindery.Core.fsproj" />
  </ItemGroup>

</Project>
