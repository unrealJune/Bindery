@page
@model DownloadsModel
@{
    ViewData["Title"] = "Jobs";
}

<header class="page-heading">
    <h1>Production job ledger</h1>
    <a class="button button-secondary" asp-page="/Index">New intake</a>
</header>

<section class="ledger-section">
    <div class="section-heading compact">
        <h2>Latest jobs</h2>
        <span class="live-key"><i aria-hidden="true"></i> Live register</span>
    </div>
    <div id="job-ledger"
         hx-get="/Downloads?handler=Rows"
         hx-trigger="every 2s"
         hx-swap="innerHTML">
        <partial name="_JobRows" model="Model.Jobs" />
    </div>
</section>
