@model MediumBadgeView
@*
    The one place the physical/digital distinction is drawn, so it reads identically on the
    search page, the holds board, and anywhere else. Never colour alone: an icon and a word.
*@
@if (Model.IsDigital)
{
    <span class="medium-badge medium-digital" title="Digital: borrowed through the library's lending app">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="6" y="2.5" width="12" height="19" rx="2" /><path d="M10.5 18.5h3" />
        </svg>
        <span>Digital@(Model.Detail is null ? null : " · " + Model.Detail)</span>
    </span>
}
else
{
    <span class="medium-badge medium-physical" title="Physical: a copy on a shelf, collected at a branch">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 4.5h4.5v15H5z" /><path d="M9.5 6h4v13.5h-4z" /><path d="M14.2 6.6l3.6-1 3.4 13.1-3.6 1z" />
        </svg>
        <span>Physical@(Model.Detail is null ? null : " · " + Model.Detail)</span>
    </span>
}
