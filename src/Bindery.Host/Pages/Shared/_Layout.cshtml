@using Bindery.Host.Plugins
@inject PluginRegistry Registry
@{
    var path = Context.Request.Path;
    var plugins = Registry.All;
    Func<string, bool> under = prefix => path.StartsWithSegments(prefix);
    var currentPlugin = plugins.FirstOrDefault(plugin => under("/plugins/" + plugin.Name));
    var inSettings = under("/settings") || path.Equals("/plugins", StringComparison.OrdinalIgnoreCase)
        || under("/FeedTokens") || under("/library-cards") || currentPlugin is not null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    @* Matches the two page grounds so the mobile browser chrome joins the theme. *@
    <meta name="theme-color" content="#eef2f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a161e" media="(prefers-color-scheme: dark)" />
    <title>@ViewData["Title"] · Bindery</title>
    @*
        htmx injects a <style> element for its indicator classes unless told not to, and the
        CSP's `style-src 'self'` blocks it — the browser logs a violation on every page. The
        styles it would have written are in bindery.css instead.
    *@
    <meta name="htmx-config" content='{"includeIndicatorStyles":false}' />
    <link rel="stylesheet" href="~/css/bindery.css" asp-append-version="true" />
    @* Render-blocking on purpose: it applies the stored theme before first paint. *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/vendor/htmx.min.js" defer></script>
    <script src="~/js/bindery.js" asp-append-version="true" defer></script>
</head>
<body>
    <!--
    THESIS: Bindery is a harbour signal station — sources arrive off the open network and are
    filed onto a shelf, and the interface is the departure board that reports on it.
    OWN-WORLD: Shoreline's ocean ramp and electromechanical flip dots meshed with
    streetCryptid's daybreak paper and floating island chrome. Hairline panels, condensed
    Rajdhani display, JetBrains Mono data, one accent per role, structure carried by rules.
    STORY: The operator reads the floor, hands over a source, follows its job across the
    board, resolves failures, and leaves with a durable OPDS catalog.
    FIRST VIEWPORT: A flip-dot station board states the floor in one word beside the intake
    docket; the live queue sits alongside it and the register runs beneath.
    FORM: Two themes from one token set — daybreak paper by day, ocean abyss by night —
    selected by `color-scheme`, so the OS preference works with no JavaScript at all.
    MOBILE: The rail becomes the island: one floating segmented bar, clear of the gesture bar.
    -->
    <div class="signal-field" aria-hidden="true"></div>

    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead">
        <a class="wordmark" asp-page="/Index" aria-label="Bindery home">
            @FlipDot.Board("B", "Bindery", "flipdot-sm")
            <strong>Bindery</strong>
        </a>

        <div class="masthead-status">
            <div class="theme-seg" data-theme-seg role="radiogroup" aria-label="Colour theme">
                <button type="button" data-theme-set="auto" role="radio" aria-checked="true" title="Follow system theme">
                    <span class="visually-hidden">Follow system theme</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        <circle cx="12" cy="12" r="8" />
                        <path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" stroke="none" />
                    </svg>
                </button>
                <button type="button" data-theme-set="light" role="radio" aria-checked="false" title="Light theme">
                    <span class="visually-hidden">Light theme</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4.2" />
                        <path d="M12 2.6v2.2M12 19.2v2.2M4.3 4.3l1.6 1.6M18.1 18.1l1.6 1.6M2.6 12h2.2M19.2 12h2.2M4.3 19.7l1.6-1.6M18.1 5.9l1.6-1.6" />
                    </svg>
                </button>
                <button type="button" data-theme-set="dark" role="radio" aria-checked="false" title="Dark theme">
                    <span class="visually-hidden">Dark theme</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 14.2A8.4 8.4 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2z" />
                    </svg>
                </button>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form method="post" asp-page="/Signin" asp-page-handler="SignOut">
                    <button class="text-action" type="submit">Sign out</button>
                </form>
            }
        </div>
    </header>

    <div class="app-frame">
        @*
            One navigation, two shapes. On the desktop it is Shoreline's hairline section
            rail; under 62rem it becomes streetCryptid's floating island — the app's only
            navigation, riding above the system gesture bar. Same markup either way, so
            there is no duplicated landmark for a screen reader to walk twice.
        *@
        <nav class="section-rail" aria-label="Primary">
            <a class="@(path == "/" ? "is-current" : null)" asp-page="/Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3v10" /><path d="M8 11l4 4 4-4" /><path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" />
                </svg>
                <span>Intake</span>
            </a>
            <a class="@(under("/Library") || under("/Book") ? "is-current" : null)" asp-page="/Library">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 4h5a2 2 0 0 1 2 2v13a2 2 0 0 0-2-2H4z" /><path d="M20 4h-5a2 2 0 0 0-2 2v13a2 2 0 0 1 2-2h5z" />
                </svg>
                <span>Shelf</span>
            </a>
            <a class="@(under("/search") || under("/borrow") ? "is-current" : null)" asp-page="/Borrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="10.5" cy="10.5" r="6" /><path d="M15 15l5.5 5.5" />
                </svg>
                <span>Search</span>
            </a>
            <a class="@(under("/holds") ? "is-current" : null)" asp-page="/Holds">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 3.5h12v17l-6-4-6 4z" />
                </svg>
                <span>Holds</span>
            </a>
            <a class="@(under("/Downloads") ? "is-current" : null)" asp-page="/Downloads">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 12h3.5l2.5-7 4 14 2.5-7H21" />
                </svg>
                <span>Jobs</span>
            </a>
            @*
                Everything set up once lives under Settings: e-readers, library cards, and each
                plugin. The island has room for Settings alone and reaches the rest through the
                hub; the desktop rail also lists them beneath it, one entry per plugin.
            *@
            <a class="@(inSettings ? "is-current" : null)" asp-page="/Settings">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 6.5h9M17 6.5h3M4 12h3M11 12h9M4 17.5h11M19 17.5h1" /><circle cx="15" cy="6.5" r="2" /><circle cx="9" cy="12" r="2" /><circle cx="17" cy="17.5" r="2" />
                </svg>
                <span>Settings</span>
            </a>

            <span class="rail-divider">Set up</span>
            <a class="rail-extra @(under("/FeedTokens") ? "is-current" : null)" asp-page="/FeedTokens">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="4.5" y="3" width="15" height="18" rx="1.5" /><path d="M9.5 17.5h5" /><path d="M8 7h8" /><path d="M8 10.5h5" />
                </svg>
                <span>E-readers</span>
            </a>
            <a class="rail-extra @(under("/library-cards") ? "is-current" : null)" asp-page="/LibraryCards">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5.5" width="18" height="13" rx="1.5" /><path d="M3 9.5h18" /><path d="M7 14.5h4" />
                </svg>
                <span>Library cards</span>
            </a>
            @foreach (var plugin in plugins)
            {
                <a class="rail-extra @(plugin == currentPlugin ? "is-current" : null)" href="@PluginLinks.Home(plugin)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 3v3.5M15 3v3.5" /><path d="M5.5 6.5h13v6a5 5 0 0 1-5 5h-3a5 5 0 0 1-5-5z" /><path d="M12 17.5V21" />
                    </svg>
                    <span>@plugin.DisplayName</span>
                </a>
            }
        </nav>

        <main id="main" class="work-surface">
            @if (TempData["Notice"] is string notice)
            {
                <div class="notice notice-success" role="status">@notice</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <a href="/opds">OPDS 1.2</a>
        <a href="/opds/v2/">OPDS 2.0</a>
        <span>Bindery @ThisAssembly.Version</span>
    </footer>
</body>
</html>
