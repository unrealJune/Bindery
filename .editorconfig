root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,fs,fsi,csproj,fsproj,props,targets}]
indent_size = 4

[*.{json,yaml,yml,cshtml,html,css,js,py}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
